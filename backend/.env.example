# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin Configuration
# Option 1: Path to downloaded Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Individual environment variables (used on cloud platforms like Render / Railway / Vercel)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
